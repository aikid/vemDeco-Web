NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Use true apenas para uma demonstração temporária sem PostgreSQL.
DEMO_MODE=false
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria
DATABASE_URL=postgresql://usuario:senha@localhost:5432/vemdeco

# Pagamentos Asaas. Use uma chave criada exclusivamente no Sandbox.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=$aact_hmlg_sua_chave_aqui
# Token próprio (32-255 caracteres), diferente da API key, configurado no Webhook do Asaas.
ASAAS_WEBHOOK_TOKEN=troque-por-um-token-aleatorio-com-pelo-menos-32-caracteres
