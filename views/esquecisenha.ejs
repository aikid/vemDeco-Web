<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="conteudo" class="auth-page">
  <aside class="auth-aside"><div><p class="eyebrow">Recupere o acesso</p><h2>Vamos ajudar você a voltar para sua conta.</h2><p>Enviaremos as instruções para o e-mail usado no cadastro.</p></div></aside>
  <section class="auth-main" aria-labelledby="forgot-title">
    <div class="card auth-card"><%- include('partials/flash') %><h1 id="forgot-title">Recuperar senha</h1><p>Informe seu e-mail para receber um link seguro.</p>
      <form class="auth-form" action="/esquecisenha" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="forgot-email">E-mail</label><input id="forgot-email" name="email" type="email" autocomplete="email" required></div><button class="button button-primary" type="submit">Enviar instruções</button></form>
      <div class="auth-links"><a href="/login">Voltar para o login</a></div>
    </div>
  </section>
</main>
<%- include('partials/end') %>
