<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="conteudo" class="section section-alt">
  <div class="container-narrow">
    <a class="back-link" href="<%= listing.href %>">← Voltar ao anúncio</a>
    <div class="card listing-form-card">
      <p class="eyebrow">Falar com o anunciante</p>
      <h1>Tenho interesse</h1>
      <p class="muted">Sua mensagem sobre <strong><%= listing.title %></strong> será enviada para <%= listing.ownerName %>.</p>
      <%- include('../partials/flash') %>
      <form class="listing-form" action="<%= listing.href %>/interesse" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="interest-phone">Telefone para contato <span class="muted">(opcional)</span></label><input id="interest-phone" name="phone" type="tel" maxlength="30" value="<%= values.phone || '' %>" placeholder="(11) 99999-9999"></div>
        <div class="field"><label for="interest-message">Mensagem</label><textarea id="interest-message" name="message" maxlength="2000" required><%= values.message || `Olá, tenho interesse neste ${listing.kind === 'PROPERTY' ? 'imóvel' : 'serviço'}. Gostaria de receber mais informações.` %></textarea></div>
        <div class="demo-notice" role="note"><strong>Contato protegido.</strong> O anunciante verá seu nome, e-mail, telefone informado e esta mensagem.</div>
        <button class="button button-primary" type="submit">Enviar interesse</button>
      </form>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/end') %>
