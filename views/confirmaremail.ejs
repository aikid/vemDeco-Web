<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="conteudo" class="auth-page">
  <aside class="auth-aside"><div><p class="eyebrow">Confirme seu cadastro</p><h2>Um passo rápido para proteger sua conta.</h2><p>Solicite outro link caso o anterior tenha expirado.</p></div></aside>
  <section class="auth-main" aria-labelledby="confirm-title">
    <div class="card auth-card"><%- include('partials/flash') %><h1 id="confirm-title">Confirmar e-mail</h1><p>Informe o e-mail cadastrado e enviaremos um novo link de confirmação.</p>
      <form class="auth-form" action="/confirmaremail" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="confirm-email">E-mail</label><input id="confirm-email" name="email" type="email" autocomplete="email" required></div><button class="button button-primary" type="submit">Enviar novo link</button></form>
      <div class="auth-links"><a href="/login">Voltar para o login</a></div>
    </div>
  </section>
</main>
<%- include('partials/end') %>
