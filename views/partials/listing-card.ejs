<article class="card listing-card">
  <% const listingHref = listing.href || `/anuncios/demo/${listing.id}` %>
  <% const kindLabel = listing.kind === 'PROPERTY' ? 'Imóvel' : listing.kind === 'PRODUCT' ? 'Produto' : 'Serviço' %>
  <% const kindIcon = listing.kind === 'PROPERTY' ? '⌂' : listing.kind === 'PRODUCT' ? 'P' : 'S' %>
  <a class="listing-card-media" href="<%= listingHref %>" aria-label="Ver <%= listing.title %>">
    <% if (listing.image?.publicUrl) { %><img src="<%= listing.image.publicUrl %>" alt="<%= listing.image.altText || listing.title %>" loading="lazy"><% } else { %><span aria-hidden="true"><%= kindIcon %></span><% } %>
  </a>
  <div class="listing-card-body">
    <div class="listing-card-meta"><span><%= kindLabel %></span><span class="status-badge status-<%= listing.status.toLowerCase() %>"><%= formatStatus(listing.status) %></span></div>
    <h2><a href="<%= listingHref %>"><%= listing.title %></a></h2>
    <strong class="listing-card-price"><%= listing.priceType === 'ON_REQUEST' ? 'Preço a combinar' : formatCurrency(listing.price) %></strong>
    <p><%= listing.city %> — <%= listing.state %></p>
    <a class="button button-ghost" href="<%= listingHref %>">Ver anúncio</a>
    <% if (typeof ownerControls !== 'undefined' && ownerControls) { %>
      <div class="listing-owner-actions">
        <a class="button button-ghost" href="/anuncios/<%= listing.id %>/editar">Editar</a>
        <form action="/anuncios/<%= listing.id %>/excluir" method="post" data-confirm="Tem certeza que deseja arquivar este anúncio?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="button button-danger" type="submit">Excluir</button>
        </form>
      </div>
    <% } %>
  </div>
</article>
