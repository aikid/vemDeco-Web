<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="conteudo" class="auth-page">
  <aside class="auth-aside">
    <div><p class="eyebrow">Bem-vindo de volta</p><h2>Seus anúncios e favoritos, sempre à mão.</h2><p>Acesse sua área para acompanhar tudo em um só lugar.</p></div>
  </aside>
  <section class="auth-main" aria-labelledby="login-title">
    <div class="card auth-card">
      <%- include('partials/flash') %>
      <h1 id="login-title">Entrar</h1>
      <p>Use o e-mail e a senha cadastrados.</p>
      <form class="auth-form" action="/login" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="returnTo" value="<%= returnTo || '' %>">
        <div class="field"><label for="login-email">E-mail</label><input id="login-email" name="email" type="email" value="<%= values?.email || '' %>" autocomplete="email" required></div>
        <div class="field"><label for="login-password">Senha</label><input id="login-password" name="password" type="password" autocomplete="current-password" required></div>
        <button class="button button-primary" type="submit">Entrar</button>
      </form>
      <div class="auth-links"><a href="/cadastro">Criar conta</a><a href="/esquecisenha">Esqueci a senha</a><a href="/confirmaremail">Confirmar e-mail</a></div>
      <% if (demoMode) { %>
        <div class="demo-access">
          <span>Sem banco configurado?</span>
          <form action="/demo/login" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button button-accent" type="submit">Entrar na demonstração</button>
          </form>
        </div>
      <% } %>
    </div>
  </section>
</main>
<%- include('partials/end') %>
