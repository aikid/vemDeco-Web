<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="conteudo">
  <section class="page-hero"><div class="container-wide"><p class="eyebrow">Fale com a gente</p><h1>Como podemos ajudar?</h1><p>Envie sua mensagem ou consulte nossos canais de atendimento.</p></div></section>
  <section class="section section-alt">
    <div class="container-wide contact-grid">
      <div class="card contact-map"><iframe title="Localização da vemDeco em Campo Limpo Paulista" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3666.7681288118083!2d-46.771864325146055!3d-23.215119348962276!2m3!1f0!2f0!3f0!3m2!1i1024!1i768!4f13.1!3m3!1m2!1s0x94cede5fc9bf04bf%3A0xf65c5477e610ad9!2sR.%20Alemanha%20-%20Jardim%20Europa%2C%20Campo%20Limpo%20Paulista%20-%20SP%2C%2013232-030!5e0!3m2!1spt-BR!2sbr!4v1698688514153!5m2!1spt-BR!2sbr" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
      <div class="card contact-card">
        <%- include('partials/flash') %>
        <h2>Envie uma mensagem</h2><p class="muted">Retornaremos o mais breve possível durante o horário de atendimento.</p>
        <form class="auth-form" action="/contato" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label for="contact-name">Nome</label><input id="contact-name" name="name" type="text" autocomplete="name" required></div>
          <div class="form-grid"><div class="field"><label for="contact-email">E-mail</label><input id="contact-email" name="email" type="email" autocomplete="email" required></div><div class="field"><label for="contact-phone">Telefone</label><input id="contact-phone" name="phone" type="tel" autocomplete="tel"></div></div>
          <div class="field"><label for="contact-message">Mensagem</label><textarea id="contact-message" name="message" required></textarea></div>
          <button class="button button-primary" type="submit">Enviar mensagem</button>
        </form>
        <hr>
        <ul class="contact-list"><li><strong>E-mail</strong><a href="mailto:atendimento@vemdeco.com.br">atendimento@vemdeco.com.br</a></li><li><strong>Telefone</strong><a href="tel:+5511984935375">(11) 98493-5375</a></li><li><strong>Horário</strong><span>Segunda a sexta, das 9h às 17h</span></li></ul>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
<%- include('partials/end') %>
