<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% const kindLabel = listing.kind === 'PROPERTY' ? 'Imóvel' : listing.kind === 'PRODUCT' ? 'Produto' : 'Serviço' %>
<% const kindIcon = listing.kind === 'PROPERTY' ? '⌂' : listing.kind === 'PRODUCT' ? 'P' : 'S' %>
<main id="conteudo">
  <section class="page-hero"><div class="container-wide"><p class="eyebrow"><%= kindLabel %> · <%= formatStatus(listing.status) %></p><h1><%= listing.title %></h1><p><%= listing.city %> — <%= listing.state %></p></div></section>
  <section class="section"><div class="container-wide listing-layout">
    <article><div class="listing-media"><% if (listing.image?.publicUrl) { %><img src="<%= listing.image.publicUrl %>" alt="<%= listing.image.altText || listing.title %>"><% } else { %><div class="listing-media-mark"><span aria-hidden="true"><%= kindIcon %></span><strong>Imagem do anúncio</strong><p class="muted">Imagem ainda não adicionada.</p></div><% } %></div>
      <div class="listing-content"><p class="listing-price"><%= listing.priceType === 'ON_REQUEST' ? 'Preço a combinar' : formatCurrency(listing.price) %></p>
        <% if (listing.kind === 'PROPERTY') { %><ul class="feature-list"><% if (listing.bedrooms != null) { %><li><%= listing.bedrooms %> quartos</li><% } %><% if (listing.bathrooms != null) { %><li><%= listing.bathrooms %> banheiros</li><% } %><% if (listing.parkingSpaces != null) { %><li><%= listing.parkingSpaces %> vagas</li><% } %><% if (listing.area != null) { %><li><%= listing.area %> m²</li><% } %></ul><% } %>
        <% if (listing.kind === 'SERVICE' && listing.service) { %><ul class="feature-list"><li><%= listing.service.serviceType %></li><% if (listing.service.serviceArea) { %><li><%= listing.service.serviceArea %></li><% } %><% if (listing.service.priceDetails) { %><li><%= listing.service.priceDetails %></li><% } %></ul><% } %>
        <% if (listing.kind === 'PRODUCT') { %><ul class="feature-list"><% if (listing.productCondition) { %><li><%= listing.productCondition %></li><% } %><li><%= listing.stock || 0 %> unidade(s) disponível(is)</li><% if (listing.deliveryDetails) { %><li><%= listing.deliveryDetails %></li><% } %></ul><% } %>
        <h2>Descrição</h2><p class="muted"><%= listing.description %></p>
      </div>
    </article>
    <aside class="card seller-card"><div class="seller-avatar" aria-hidden="true"><%= listing.ownerName ? listing.ownerName.split(' ').map((part) => part[0]).slice(0, 2).join('') : 'VD' %></div><p class="eyebrow">Anunciante</p><h2><%= listing.ownerName || 'Visitante Demo' %></h2><p class="muted"><%= listing.ownerName ? 'Demonstre interesse para notificar o anunciante e iniciar o contato.' : 'Anúncio temporário criado para validar a experiência.' %></p><% if (listing.kind === 'PRODUCT' && listing.ownerName) { %><% if (user && user.id === listing.ownerId) { %><a class="button button-primary" href="/anuncios/<%= listing.id %>/editar">Editar meu produto</a><% } else if ((listing.stock || 0) > 0) { %><a class="button button-primary" href="<%= user ? `${listing.href}/checkout` : `/login?returnTo=${encodeURIComponent(`${listing.href}/checkout`)}` %>">Comprar agora</a><% } else { %><button class="button button-primary" type="button" disabled>Produto esgotado</button><% } %><% } else if (listing.ownerName) { %><% if (user && user.id === listing.ownerId) { %><a class="button button-primary" href="/anuncios/<%= listing.id %>/editar">Editar meu anúncio</a><% } else { %><a class="button button-primary" href="<%= user ? `${listing.href}/interesse` : `/login?returnTo=${encodeURIComponent(`${listing.href}/interesse`)}` %>"><%= user ? 'Tenho interesse' : 'Entrar para demonstrar interesse' %></a><% } %><% } else { %><a class="button button-primary" href="/meus-anuncios">Meus anúncios</a><a class="button button-ghost" href="/anuncios/novo">Criar outro</a><% } %></aside>
  </div></section>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/end') %>
