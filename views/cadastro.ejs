<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="conteudo" class="auth-page">
  <aside class="auth-aside">
    <div><p class="eyebrow">Faça parte</p><h2>Uma conta para anunciar, favoritar e conversar.</h2><p>Comece com seus dados essenciais. Você poderá completar seu perfil depois.</p></div>
  </aside>
  <section class="auth-main" aria-labelledby="register-title">
    <div class="card auth-card">
      <%- include('partials/flash') %>
      <h1 id="register-title">Criar conta</h1><p>Preencha seus dados para começar.</p>
      <form class="auth-form" action="/cadastro" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="register-name">Nome completo</label><input id="register-name" name="name" type="text" value="<%= values?.name || '' %>" autocomplete="name" required></div>
        <div class="field"><label for="register-email">E-mail</label><input id="register-email" name="email" type="email" value="<%= values?.email || '' %>" autocomplete="email" required></div>
        <div class="field"><label for="register-phone">Telefone</label><input id="register-phone" name="phone" type="tel" value="<%= values?.phone || '' %>" autocomplete="tel" inputmode="tel"></div>
        <div class="field"><label for="register-city">Cidade</label><input id="register-city" name="city" type="text" autocomplete="address-level2"></div>
        <div class="field"><label for="register-document">CPF ou CNPJ</label><input id="register-document" name="document" type="text" value="<%= values?.document || '' %>" inputmode="numeric" aria-describedby="document-hint"><p class="field-hint" id="document-hint">Usado apenas para validação da conta.</p></div>
        <div class="field"><label for="register-password">Senha</label><input id="register-password" name="password" type="password" autocomplete="new-password" minlength="8" required><p class="field-hint">Use pelo menos 8 caracteres.</p></div>
        <button class="button button-primary" type="submit">Criar minha conta</button>
      </form>
      <div class="auth-links"><a href="/login">Já tenho uma conta</a></div>
    </div>
  </section>
</main>
<%- include('partials/end') %>
